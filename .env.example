# Laya serving configuration
LAYA_HOST=0.0.0.0
LAYA_PORT=8089
LAYA_DEVICE=auto
LAYA_MODELS=english,multilingual
# Pin a Hugging Face model revision for reproducible deployments.
# LAYA_REVISION=reviewed-commit-or-tag
LAYA_PRELOAD=true
LAYA_MAX_LOADED=2
LAYA_THREADS=4
LAYA_MAX_CONCURRENT=4
LAYA_MAX_BODY_BYTES=2000000
LAYA_MAX_STATE_CHARS=50000
LAYA_MAX_QUESTIONS=100
LAYA_MAX_BATCH_STATES=64
LAYA_MAX_TOKEN_BUDGET=8192
# LAYA_API_KEY=replace-with-a-long-random-value
# LAYA_CORS_ORIGINS=https://your-app.example
